<!-- Styles and colors are in App.xaml. -->
<Window x:Class="Stedjcast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stedjcast"
        Title="Stedjcast"
        Height="800"
        Width="1040"
        MinHeight="700"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="18"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PageBrush}"
        Closing="Window_Closing">

    <Grid Margin="12">
        <TabControl Background="Transparent" BorderThickness="0" Padding="0,8,0,0">

            <TabItem Header="LIVE" AutomationProperties.Name="Live screen">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <local:ChannelStrip x:Name="MicStrip" Grid.Column="0"
                                        Title="MIC" ChannelName="Microphone"
                                        Accent="{StaticResource MicAccentBrush}"/>
                    <local:ChannelStrip x:Name="LoopbackStrip" Grid.Column="1"
                                        Title="PC AUDIO" ChannelName="PC audio"
                                        Accent="{StaticResource LoopbackAccentBrush}"/>
                    <local:ChannelStrip x:Name="MasterStrip" Grid.Column="2"
                                        Title="MASTER" ChannelName="Master"
                                        Accent="{StaticResource MasterAccentBrush}"/>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="8,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource BigActionButtonStyle}"
                                Content="▶  GO LIVE" Background="#16A34A" Click="Start_Click" IsEnabled="False"
                                AutomationProperties.Name="Start broadcast"/>

                        <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource BigActionButtonStyle}"
                                Content="■  STOP" Background="#DC2626" Click="Stop_Click" IsEnabled="False"
                                AutomationProperties.Name="Stop broadcast"/>
                    </Grid>

                    <!-- The banner color is set in code from the status (gray/blue/green/orange/red). -->
                    <Border x:Name="StatusBanner" Grid.Row="2" Grid.ColumnSpan="3"
                            Margin="8,14,8,8" Padding="14" CornerRadius="12" Background="#E2E8F0">
                        <TextBlock x:Name="StatusText"
                                   Text="NOT CONNECTED"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS" AutomationProperties.Name="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" Margin="0,0,0,16">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Audio devices" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Microphone" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="FriendlyName" SelectedValuePath="ID"
                                          AutomationProperties.Name="Microphone device"/>

                                <TextBlock Text="PC audio output to capture" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="LoopbackCombo" DisplayMemberPath="FriendlyName" SelectedValuePath="ID"
                                          AutomationProperties.Name="PC audio device"/>

                                <TextBlock Text="VST3 plugin folder" Style="{StaticResource FieldLabelStyle}"/>
                                <DockPanel Margin="0,4,0,4">
                                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" MinHeight="40"
                                            Click="Vst3FolderButton_Click"
                                            AutomationProperties.Name="Choose the VST3 plugin folder"/>
                                    <TextBox x:Name="Vst3FolderBox" Margin="0"
                                             AutomationProperties.Name="VST3 plugin folder"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Shoutcast server" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Server type" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ServerTypeCombo" AutomationProperties.Name="Server type">
                                    <ComboBoxItem Content="Shoutcast v1"/>
                                    <ComboBoxItem Content="Shoutcast v2"/>
                                </ComboBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Server / address" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="ServerHostBox" AutomationProperties.Name="Server address"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="ServerPortBox" AutomationProperties.Name="Server port"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Source password" Style="{StaticResource FieldLabelStyle}"/>
                                        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Source password"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stream ID" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="StreamIdBox" AutomationProperties.Name="Stream ID"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="MP3 bitrate (kbps)" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="BitrateCombo" AutomationProperties.Name="MP3 bitrate">
                                    <ComboBoxItem Content="96"/>
                                    <ComboBoxItem Content="128"/>
                                    <ComboBoxItem Content="192"/>
                                    <ComboBoxItem Content="256"/>
                                </ComboBox>

                                <CheckBox x:Name="PublicCheck" Content="Public server (listed in the directory)"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Stream info" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Stream name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="StreamNameBox" AutomationProperties.Name="Stream name"/>

                                <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="DescriptionBox" AutomationProperties.Name="Description"/>

                                <TextBlock Text="URL" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="UrlBox" AutomationProperties.Name="URL"/>

                                <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="GenreBox" AutomationProperties.Name="Genre"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Options" Style="{StaticResource SectionTitleStyle}"/>

                                <CheckBox x:Name="AutoStartCheck" Content="Go live automatically on startup"/>
                                <CheckBox x:Name="TestModeCheck" Content="Local test mode: save WAV files to Music\Stedjcast, don't broadcast"/>
                                <CheckBox x:Name="LoggingCheck" Content="Enable technical log"/>
                            </StackPanel>
                        </Border>

                        <Button Content="SAVE SETTINGS" Margin="8" Height="60" FontSize="20"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
