<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- VST3 hosting calls plugin vtables through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.1</Version>
    <Product>Stedjcast</Product>
    <Authors>beppeilgommista</Authors>
    <Description>Stedjcast - Shoutcast web radio broadcaster</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- VC++ runtime shipped next to the exe (app-local deployment, allowed by Microsoft):
         plugins built against the dynamic runtime load on PCs without the redistributable. -->
    <None Include="$(SystemRoot)\System32\msvcp140.dll;$(SystemRoot)\System32\vcruntime140.dll;$(SystemRoot)\System32\vcruntime140_1.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <!-- Binary redistribution of the MIT/BSD components requires shipping their notices. -->
    <None Include="LICENSE;THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Files brought in by the packages that this x64 app never uses. -->
  <Target Name="RemoveUnusedPublishFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libmp3lame.32.dll" />
  </Target>

</Project>
